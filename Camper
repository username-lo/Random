<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,user-scalable=no">
<title>Forest Runner</title>

<style>
* {
  box-sizing: border-box;
  -webkit-user-select: none;
  user-select: none;
}

html, body {
  margin: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #101820;
  font-family: Arial, sans-serif;
}

canvas {
  display: block;
  width: 100vw;
  height: 100vh;
  image-rendering: pixelated;
}

#ui {
  position: fixed;
  top: 15px;
  left: 15px;
  right: 15px;
  display: flex;
  justify-content: space-between;
  color: white;
  font-size: 20px;
  font-weight: bold;
  pointer-events: none;
  text-shadow: 2px 2px #000;
}

#message {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  color: white;
  text-align: center;
  background: rgba(0,0,0,.55);
}

#message h1 {
  font-size: 48px;
  margin: 10px;
  text-shadow: 4px 4px #000;
}

#message p {
  font-size: 20px;
}

button {
  border: 0;
  border-radius: 12px;
  padding: 14px 28px;
  font-size: 20px;
  font-weight: bold;
  background: #ffd43b;
  color: #222;
}

.hidden {
  display: none !important;
}

/* Mobile controls */
#controls {
  position: fixed;
  bottom: 25px;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  padding: 0 25px;
  pointer-events: none;
}

.controlGroup {
  display: flex;
  gap: 12px;
}

.control {
  width: 65px;
  height: 65px;
  border-radius: 16px;
  background: rgba(255,255,255,.25);
  border: 2px solid rgba(255,255,255,.5);
  color: white;
  font-size: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
  touch-action: none;
}
</style>
</head>

<body>

<canvas id="game"></canvas>

<div id="ui">
  <div>🪙 <span id="coins">0</span></div>
  <div>❤️ <span id="health">3</span></div>
  <div>🏆 <span id="score">0</span></div>
</div>

<div id="message">
  <h1>🌲 Forest Runner</h1>
  <p>Collect coins and survive the forest!</p>
  <p>Computer: WASD / Arrow Keys</p>
  <p>iPad: Use the buttons below</p>
  <button id="start">PLAY</button>
</div>

<div id="controls">
  <div class="controlGroup">
    <div class="control" data-key="left">◀</div>
    <div class="control" data-key="right">▶</div>
  </div>

  <div class="controlGroup">
    <div class="control" data-key="up">▲</div>
    <div class="control" data-key="down">▼</div>
  </div>
</div>

<script>
const canvas = document.getElementById("game");
const ctx = canvas.getContext("2d");

let W, H;
let running = false;

let coins = 0;
let score = 0;
let health = 3;
let speed = 3;

const keys = {
  up:false,
  down:false,
  left:false,
  right:false
};

const player = {
  x:0,
  y:0,
  size:30
};

let coinObjects = [];
let enemies = [];
let trees = [];

function resize() {
  W = canvas.width = window.innerWidth;
  H = canvas.height = window.innerHeight;

  if (!running) {
    player.x = W / 2;
    player.y = H / 2;
  }
}

window.addEventListener("resize", resize);
resize();

/* Keyboard */

window.addEventListener("keydown", e => {
  if (
    e.key === "ArrowUp" ||
    e.key.toLowerCase() === "w"
  ) keys.up = true;

  if (
    e.key === "ArrowDown" ||
    e.key.toLowerCase() === "s"
  ) keys.down = true;

  if (
    e.key === "ArrowLeft" ||
    e.key.toLowerCase() === "a"
  ) keys.left = true;

  if (
    e.key === "ArrowRight" ||
    e.key.toLowerCase() === "d"
  ) keys.right = true;
});

window.addEventListener("keyup", e => {
  if (
    e.key === "ArrowUp" ||
    e.key.toLowerCase() === "w"
  ) keys.up = false;

  if (
    e.key === "ArrowDown" ||
    e.key.toLowerCase() === "s"
  ) keys.down = false;

  if (
    e.key === "ArrowLeft" ||
    e.key.toLowerCase() === "a"
  ) keys.left = false;

  if (
    e.key === "ArrowRight" ||
    e.key.toLowerCase() === "d"
  ) keys.right = false;
});

/* iPad buttons */

document.querySelectorAll(".control").forEach(button => {

  const key = button.dataset.key;

  button.addEventListener("pointerdown", e => {
    e.preventDefault();
    keys[key] = true;
  });

  button.addEventListener("pointerup", e => {
    e.preventDefault();
    keys[key] = false;
  });

  button.addEventListener("pointercancel", () => {
    keys[key] = false;
  });

  button.addEventListener("pointerleave", () => {
    keys[key] = false;
  });
});

/* Start */

document.getElementById("start").onclick = startGame;

function startGame() {

  running = true;

  coins = 0;
  score = 0;
  health = 3;
  speed = 3;

  player.x = W / 2;
  player.y = H / 2;

  coinObjects = [];
  enemies = [];
  trees = [];

  document.getElementById("message").classList.add("hidden");

  for (let i = 0; i < 35; i++) {
    trees.push({
      x: Math.random() * W,
      y: Math.random() * H,
      size: 25 + Math.random() * 30
    });
  }

  for (let i = 0; i < 8; i++) {
    spawnCoin();
  }

  for (let i = 0; i < 3; i++) {
    spawnEnemy();
  }
}

/* Spawn objects */

function spawnCoin() {

  coinObjects.push({
    x: Math.random() * (W - 40) + 20,
    y: Math.random() * (H - 40) + 20,
    size: 14
  });
}

function spawnEnemy() {

  let side = Math.floor(Math.random() * 4);

  let x, y;

  if (side === 0) {
    x = -30;
    y = Math.random() * H;
  } else if (side === 1) {
    x = W + 30;
    y = Math.random() * H;
  } else if (side === 2) {
    x = Math.random() * W;
    y = -30;
  } else {
    x = Math.random() * W;
    y = H + 30;
  }

  enemies.push({
    x,
    y,
    size:25,
    speed:1 + Math.random() * 1.5
  });
}

/* Collision */

function distance(a,b) {
  return Math.hypot(a.x-b.x, a.y-b.y);
}

/* Update */

function update() {

  if (!running) return;

  let dx = 0;
  let dy = 0;

  if (keys.left) dx--;
  if (keys.right) dx++;
  if (keys.up) dy--;
  if (keys.down) dy++;

  if (dx !== 0 || dy !== 0) {

    const length = Math.hypot(dx,dy);

    dx /= length;
    dy /= length;

    player.x += dx * speed;
    player.y += dy * speed;
  }

  /* Keep player inside screen */

  player.x = Math.max(
    player.size / 2,
    Math.min(W - player.size / 2, player.x)
  );

  player.y = Math.max(
    player.size / 2,
    Math.min(H - player.size / 2, player.y)
  );

  /* Coins */

  for (let i = coinObjects.length - 1; i >= 0; i--) {

    const c = coinObjects[i];

    if (distance(player,c) < 25) {

      coins++;
      score += 10;

      coinObjects.splice(i,1);
      spawnCoin();
    }
  }

  /* Enemies */

  enemies.forEach(enemy => {

    let dx = player.x - enemy.x;
    let dy = player.y - enemy.y;

    let d = Math.hypot(dx,dy);

    if (d > 0) {
      enemy.x += (dx/d) * enemy.speed;
      enemy.y += (dy/d) * enemy.speed;
    }

    if (distance(player,enemy) < 30) {

      health--;

      enemy.x = Math.random() * W;
      enemy.y = Math.random() * H;

      if (health <= 0) {
        gameOver();
      }
    }
  });

  score++;

  /* Difficulty */

  speed = 3 + Math.floor(score / 1000) * .5;

  if (score % 700 === 0 && enemies.length < 10) {
    spawnEnemy();
  }

  document.getElementById("coins").textContent = coins;
  document.getElementById("health").textContent = health;
  document.getElementById("score").textContent = score;
}

/* Draw */

function draw() {

  /* Grass */

  ctx.fillStyle = "#5ca34a";
  ctx.fillRect(0,0,W,H);

  /* Grass pixels */

  ctx.fillStyle = "#4d913d";

  for (let x = 0; x < W; x += 40) {
    for (let y = 0; y < H; y += 40) {
      if ((x+y) % 80 === 0) {
        ctx.fillRect(x,y,8,8);
      }
    }
  }

  /* Trees */

  trees.forEach(tree => {

    ctx.fillStyle = "#70452a";

    ctx.fillRect(
      tree.x - 5,
      tree.y,
      10,
      tree.size
    );

    ctx.fillStyle = "#236b32";

    ctx.fillRect(
      tree.x - tree.size / 2,
      tree.y - tree.size / 2,
      tree.size,
      tree.size
    );

    ctx.fillStyle = "#2f873b";

    ctx.fillRect(
      tree.x - tree.size / 3,
      tree.y - tree.size / 1.5,
      tree.size / 1.5,
      tree.size / 1.5
    );
  });

  /* Coins */

  coinObjects.forEach(c => {

    ctx.fillStyle = "#eabf2f";

    ctx.fillRect(
      c.x - c.size,
      c.y - c.size,
      c.size * 2,
      c.size * 2
    );

    ctx.fillStyle = "#fff08a";

    ctx.fillRect(
      c.x - 4,
      c.y - 8,
      5,
      16
    );
  });

  /* Enemies */

  enemies.forEach(enemy => {

    ctx.fillStyle = "#7d2635";

    ctx.fillRect(
      enemy.x - enemy.size / 2,
      enemy.y - enemy.size / 2,
      enemy.size,
      enemy.size
    );

    ctx.fillStyle = "white";

    ctx.fillRect(enemy.x - 9,enemy.y - 7,6,6);
    ctx.fillRect(enemy.x + 3,enemy.y - 7,6,6);

    ctx.fillStyle = "black";

    ctx.fillRect(enemy.x - 7,enemy.y - 5,3,3);
    ctx.fillRect(enemy.x + 5,enemy.y - 5,3,3);
  });

  /* Player */

  ctx.fillStyle = "#2764d8";

  ctx.fillRect(
    player.x - player.size / 2,
    player.y - player.size / 2,
    player.size,
    player.size
  );

  /* Player face */

  ctx.fillStyle = "white";

  ctx.fillRect(
    player.x - 9,
    player.y - 7,
    6,
    6
  );

  ctx.fillRect(
    player.x + 3,
    player.y - 7,
    6,
    6
  );

  ctx.fillStyle = "black";

  ctx.fillRect(
    player.x - 7,
    player.y - 5,
    3,
    3
  );

  ctx.fillRect(
    player.x + 5,
    player.y - 5,
    3,
    3
  );
}

/* Game over */

function gameOver() {

  running = false;

  document.getElementById("message").classList.remove("hidden");

  document.querySelector("#message h1").textContent =
    "GAME OVER";

  document.querySelector("#message p").textContent =
    "You collected " + coins + " coins!";

  document.querySelector("#message p:nth-of-type(2)").textContent =
    "Score: " + score;

  document.querySelector("#message p:nth-of-type(3)").textContent =
    "Try to beat your score!";

  document.getElementById("start").textContent = "PLAY AGAIN";
}

/* Game loop */

function loop() {

  update();
  draw();

  requestAnimationFrame(loop);
}

loop();
</script>

</body>
</html>
